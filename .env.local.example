# (ไม่บังคับ) สำหรับรัน node scripts/ensure-global-holidays.mjs สร้างตาราง global_holidays
# หาได้ที่ Supabase Dashboard → Project Settings → Database → Connection string (URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Session Secret - สร้างด้วย: openssl rand -base64 32
SESSION_SECRET=your-super-secret-key-at-least-32-characters-long

# URL ของแอป (ใช้สร้าง PDF / OAuth)
# - local: http://localhost:3000
# - production (Vercel): https://jarnsek.com
# ห้ามตั้งเป็น localhost บน server จริง — จะทำให้ Google OAuth เด้งกลับ localhost
APP_URL=http://localhost:3000

# Google OAuth — ตั้งครั้งเดียวบนเซิร์ฟเวอร์ แต่ละโรงเรียนกด "เชื่อมต่อ Google Drive" เอง
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Production ล็อกไว้ที่โดเมนนี้ (ต้องมีใน Google Cloud Console ด้วย):
# Authorized JavaScript origins: https://jarnsek.com
# Authorized redirect URIs: https://jarnsek.com/api/integrations/google-drive/callback
# GOOGLE_OAUTH_REDIRECT_URI=https://jarnsek.com/api/integrations/google-drive/callback
# ตัวอย่าง local:
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# ลืมรหัสผ่าน (แอดมินรร) — ใน Supabase Dashboard → Authentication → URL Configuration
# เพิ่ม Redirect URLs:
#   http://localhost:3000/auth/reset-password
#   https://jarnsek.com/auth/reset-password
# และเปิดใช้ Email provider + ตั้ง SMTP (หรือใช้เมลทดสอบของ Supabase)

# (ทางเลือก) Service Account แบบเดิม — ไม่จำเป็นถ้าใช้ OAuth แล้ว
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# (ไม่บังคับ) path Chrome สำหรับสร้าง PDF ใน dev
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
